# =============================================================================
# SecureVault - Environment Variables
# =============================================================================
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env
#
# NEVER commit the real `.env` file to version control. It contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
# Secret key used for session signing and cryptographic operations.
# REQUIRED — there is no default. It must be a strong, random secret.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT commit a real value here; set it in your local `.env` only.
SECRET_KEY=

# Enable/disable debug mode (true/false).
# Production-safe default is false. Keep it false outside local development.
DEBUG=false

# Host and port for the development server.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# -----------------------------------------------------------------------------
# PostgreSQL / SQLAlchemy
# -----------------------------------------------------------------------------
# Connection string for the PostgreSQL database.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://securevault:securevault@db:5432/securevault

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis connection URL used for caching and as the Celery broker.
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
# Celery broker and result backend URLs (both use Redis by default).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timezone used by Celery for scheduling.
CELERY_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Session lifetime in days.
SESSION_LIFETIME_DAYS=1

# Whether the session cookie is only sent over HTTPS (true/false).
# Production-safe default is true. Set to false only for local development
# over plain HTTP.
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Security (foundation only)
# -----------------------------------------------------------------------------
# Maximum upload size in bytes (100 MB default). Used by future file features.
MAX_CONTENT_LENGTH=104857600

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Maximum size (in bytes) of a single uploaded file (10 MB default). Enforced
# by the upload service.
MAX_UPLOAD_SIZE=10485760

# Maximum length (in characters) of an original filename (255 default).
MAX_FILENAME_LENGTH=255

# Comma-separated allowlist of MIME types accepted for upload. The MIME type
# supplied by the client/browser is treated as UNTRUSTED: it is checked against
# this allowlist only and is NOT proof of the file's actual contents (magic-byte
# validation is implemented separately). Values are normalized to lowercase.
SUPPORTED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain

# -----------------------------------------------------------------------------
# Seed users
# -----------------------------------------------------------------------------
# Credentials used by `flask seed` to create the default admin user.
# Admin credentials are REQUIRED — there are no defaults. Set strong, unique
# values in your local `.env`. Do NOT commit real passwords here.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional demo user. If all three demo variables are set, a non-admin demo
# user is created; otherwise the demo user is skipped. No hardcoded fallback.
SEED_DEMO_USERNAME=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=

# -----------------------------------------------------------------------------
# Rate limiting (Flask-Limiter)
# -----------------------------------------------------------------------------
# Storage backend for rate-limit counters. Production uses Redis (the same
# instance used for caching and the Celery broker). Do not change this unless
# you have a specific reason; it must point to a shared, persistent store in
# production so limits are enforced across all app instances.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Strategy used to enforce limits. "fixed-window" resets the counter at the
# start of each window. Alternatives: "moving-window", "sliding-window".
RATELIMIT_STRATEGY=fixed-window

# Per-endpoint rate limits. Each applies ONLY to the POST method of the
# endpoint (GET requests are not limited). Limits are per client IP.
# Format: "<count> per <unit>" where unit is second/minute/hour/day.
#
# Login: slow brute-force attempts (10 per minute per IP).
LOGIN_RATE_LIMIT=10 per minute
# Registration: slow automated account-creation abuse (5 per hour per IP).
REGISTER_RATE_LIMIT=5 per hour
# Upload: slow upload abuse (30 per minute per IP).
UPLOAD_RATE_LIMIT=30 per minute
